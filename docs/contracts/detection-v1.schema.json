{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "detection-v1",
  "type": "object",
  "required": [
    "schema_version",
    "camera_id",
    "frame_index",
    "timestamp_ms",
    "frame_width",
    "frame_height",
    "people_count",
    "detections"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version identifier for the contract, e.g. detection-v1"
    },
    "camera_id": {
      "type": "string",
      "description": "Camera identifier"
    },
    "frame_index": {
      "type": "integer",
      "description": "Frame sequence number"
    },
    "timestamp_ms": {
      "type": "integer",
      "description": "Timestamp in milliseconds"
    },
    "frame_width": {
      "type": "integer",
      "description": "Frame width in pixels"
    },
    "frame_height": {
      "type": "integer",
      "description": "Frame height in pixels"
    },
    "people_count": {
      "type": "integer",
      "description": "Number of people detected in the frame"
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["detection_id", "class_id", "class_name", "confidence", "bbox_xyxy"],
        "properties": {
          "detection_id": {
            "type": "string",
            "description": "Unique detection identifier"
          },
          "class_id": {
            "type": "integer",
            "description": "Numeric class label"
          },
          "class_name": {
            "type": "string",
            "description": "Human-readable class name, e.g. person"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Detection confidence score"
          },
          "bbox_xyxy": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x1, y1, x2, y2] numeric pixel coordinates"
          }
        }
      },
      "description": "List of detections in the frame"
    }
  }
}