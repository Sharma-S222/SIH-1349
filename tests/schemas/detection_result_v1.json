{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DetectionResult v1",
  "description": "Schema for the Member 1 DetectionResult v1 output contract. Authoritative version at docs/contracts/detection-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "camera_id",
    "frame_index",
    "timestamp_ms",
    "frame_width",
    "frame_height",
    "people_count",
    "detections"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "detection-v1"
    },
    "camera_id": {
      "type": "string"
    },
    "frame_index": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "frame_width": {
      "type": "integer",
      "minimum": 1
    },
    "frame_height": {
      "type": "integer",
      "minimum": 1
    },
    "people_count": {
      "type": "integer",
      "minimum": 0
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["detection_id", "class_id", "class_name", "confidence", "bbox_xyxy"],
        "additionalProperties": false,
        "properties": {
          "detection_id": {
            "type": "string"
          },
          "class_id": {
            "type": "integer",
            "minimum": 0
          },
          "class_name": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "bbox_xyxy": {
            "type": "array",
            "items": { "type": "integer" },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    "inference_ms": {
      "type": "number",
      "minimum": 0
    },
    "model": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    }
  }
}